@* NOTE

CARDS MENU is a new from-scratch idea to solve the age-old problem of having a simple
way to just show the children of the current page as cards using DDR Menu and DNN 
built in stuff. 
Tailwind: Yes
JavaScript: No
*@

@*
  Init and trigger the magic.
  ****************************************************************************@

<nav class="bg-white py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <div class="mx-auto mt-16 max-w-2xl sm:mt-20 lg:mt-24 lg:max-w-none">
      <dl class="grid max-w-xl grid-cols-1 gap-x-8 gap-y-16 lg:max-w-none lg:grid-cols-3">
        @RenderPages(Model.Source.root.Children)
      </dl>
    </div>
  </div>
</nav>


@functions
{
  public HtmlString RenderPages(IEnumerable<MenuNode> pages)
  {
    System.Text.StringBuilder output = new System.Text.StringBuilder();

    foreach (var page in pages)
    {
      output.AppendLine($"<div class=\"flex flex-col\">");
      output.AppendLine($"<dt class=\"flex items-center gap-x-3 text-base/7 font-semibold text-gray-900\">");
      if (Text.Has(page.Icon))
      {
      output.AppendLine($"<img title=\"Using Small Icon in Page Setting\" src=\"{page.Icon}\" alt=\"{page.Text}\" class=\"size-6 flex-none text-indigo-600\" />");
      }
      else
      {
      output.AppendLine($@"
        <svg viewBox=""0 0 20 20"" fill=""currentColor"" data-slot=""icon"" aria-hidden=""true"" class=""size-6 flex-none text-indigo-600"">
          <path d=""M5.5 17a4.5 4.5 0 0 1-1.44-8.765 4.5 4.5 0 0 1 8.302-3.046 3.5 3.5 0 0 1 4.504 4.272A4 4 0 0 1 15 17H5.5Zm3.75-2.75a.75.75 0 0 0 1.5 0V9.66l1.95 2.1a.75.75 0 1 0 1.1-1.02l-3.25-3.5a.75.75 0 0 0-1.1 0l-3.25 3.5a.75.75 0 1 0 1.1 1.02l1.95-2.1v4.59Z"" clip-rule=""evenodd"" fill-rule=""evenodd"" />
        </svg>
      ");
      }
      output.AppendLine($"{page.Text}");
      output.AppendLine($"</dt>");
      output.AppendLine($@"
        <dd class=""mt-4 flex flex-auto flex-col text-base/7 text-gray-600 dark:text-gray-400"" title=""{MakeDebugTooltip(page)}"">
          <p class=""flex-auto"">{page.Title}</p>
          <p class=""mt-6"">
            <a href=""{page.Url}"" class=""text-sm/6 font-semibold text-indigo-600 hover:text-indigo-500"">
              Learn more <span aria-hidden=""true"">→</span>
            </a>
          </p>
        </dd>
      ");
      output.AppendLine($"</div>");
    }
    return new HtmlString(output.ToString());
  }

  public string MakeDebugTooltip(MenuNode page)
  {
    return $"TabId: {page.TabId}\n HasChildren: {page.HasChildren()}\n Depth: {page.Depth}\n Enabled: {page.Enabled}\n Breadcrumb: {page.Breadcrumb}\n Target: {page.Target}\n Url: {page.Url}\n Icon: {page.Icon}\n LargeImage: {page.LargeImage}\n Text: {page.Text}\n Title: {page.Title}\n ";
  } 
}

